# Числовой ID сообщества без минуса, например для vk.com/club123456:
VK_GROUP_ID=123456

# Ключ сообщества используется только для проверки опубликованного поста.
# Само размещение выполняется через уже авторизованный браузерный профиль.
VK_COMMUNITY_TOKEN=replace_with_community_token

# ID приложения из кабинета VK ID:
VK_CLIENT_ID=12345678

# Для публичного приложения оставьте пустым. Для конфиденциального приложения
# укажите сервисный ключ доступа локально (не отправляйте его в переписку).
VK_SERVICE_TOKEN=

# Эти значения автоматически заполнит команда `python3 vk_auth.py`.
VK_ACCESS_TOKEN=replace_with_user_access_token
VK_REFRESH_TOKEN=
VK_DEVICE_ID=
VK_TOKEN_EXPIRES_AT=0
VK_TOKEN_SCOPE=

# Пользователь, который один раз написал сообществу. Нужен только для
# совместимого с ключом сообщества сервера загрузки изображений:
VK_UPLOAD_PEER_ID=

# Актуальная версия официальной схемы VK API:
VK_API_VERSION=5.199

# Локальный HTTPS-порт веб-интерфейса Chromium.
VK_CHROMIUM_HTTPS_PORT=3001

# Размер партии товаров. Значение 50 устойчиво обрабатывается импортом VK.
VK_MARKET_BATCH_SIZE=50
VK_MARKET_POLL_SECONDS=30
VK_MARKET_RETRIES=3
